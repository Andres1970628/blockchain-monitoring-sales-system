datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  company   String?
  plan      String   @default("Not specified")
  message   String?
  type      String   @default("demo")
  source    String   @default("web")
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
  @@index([status])
}

model Subscription {
  id                String    @id @default(cuid())
  email             String    @unique
  stripeId          String    @unique
  plan              String
  status            String    @default("active")
  amount            Int
  currency          String    @default("usd")
  currentPeriodStart DateTime?
  currentPeriodEnd  DateTime?
  canceledAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([email])
  @@index([stripeId])
}

model Payment {
  id              String   @id @default(cuid())
  email           String
  stripePaymentId String   @unique
  amount          Int
  currency        String   @default("usd")
  status          String
  plan            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
}
